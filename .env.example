# Backend Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String (Required in production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/abesec_admission?retryWrites=true&w=majority

# JWT Configuration (Use a long random secret in production)
JWT_SECRET=replace_with_a_strong_64_char_random_secret_key
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for separate frontend deployment)
CORS_ORIGIN=http://localhost:5173

# Optional: Set to true to serve frontend/dist from the Express backend
SERVE_FRONTEND=true

# Optional: Auto-seed demo accounts & courses if database is empty (set false after initial setup if desired)
AUTO_SEED=true

# Demo Seed Overrides (Change these in production!)
SEED_ADMIN_EMAIL=admin@abesec.ac.in
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STUDENT_EMAIL=student@abesec.ac.in
SEED_STUDENT_PASSWORD=Student@12345
